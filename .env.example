# Copier en .env puis exporter : set -a; source .env; set +a; npm start

# Obligatoire : jeton Bearer (16 caractères minimum). Générer : openssl rand -hex 32
GATEWAY_TOKEN=

# Obligatoire : dossiers absolus où Claude peut travailler, séparés par « : ».
# Le premier sert de dossier par défaut.
GATEWAY_ROOTS=/home/utilisateur/projets

# Adresse et port d'écoute. Par défaut : boucle locale uniquement.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Plafond des outils (séparés par des virgules). Une requête ne peut jamais en
# demander d'autres. Par défaut : lecture seule. Ajouter Edit, Write ou Bash
# revient à donner ces pouvoirs à quiconque détient le jeton.
GATEWAY_ALLOWED_TOOLS=Read,Glob,Grep

# Limites
GATEWAY_MAX_CONCURRENT=2
GATEWAY_TIMEOUT_MS=600000
GATEWAY_MAX_BUDGET_USD=1
GATEWAY_MAX_TURNS=20
GATEWAY_MAX_BODY_BYTES=1000000

# Authentification auprès de Claude : celle de la machine (claude login), ou
# ANTHROPIC_API_KEY=... pour une clé d'API.
